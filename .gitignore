# .gitignore — files Git should never store in the repository.

# Build output (recreated by "dotnet build" / "dotnet publish").
# These folders also contain copies of the settings files.
bin/
obj/
publish/

# The React app: downloaded packages, and the built site that Vite writes
# into site/wwwroot (recreated by "npm install" / "npm run build")
node_modules/
site/wwwroot/

# Visual Studio / VS Code / Rider user files
.vs/
.vscode/
.idea/
*.user
*.suo

# Secrets: the real .env with the database password only lives on the NAS
.env
deploy/.env

# The CV document contains private contact details (phone number) and is not
# needed by the site (the CV content lives in the database)
v1/Data/*.pdf

# Local settings overrides, if you create any
appsettings.*.local.json
.claude/settings.local.json

# OS files
Thumbs.db
.DS_Store
